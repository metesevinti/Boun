# Moodle Web Service token'ini buraya yaz
# Moodle > Preferences > Security keys > Mobile web service
MOODLE_TOKEN=buraya_kendi_tokenin
MOODLE_URL=https://moodle.bogazici.edu.tr

# Moodle user ID'ni bulmak icin:
# python3 -c "from sync.moodle_client import get_user_courses; print(get_user_courses())"
# veya Moodle profilinde URL'deki id= parametresi
MOODLE_USER_ID=12345

# Derslerini tanimla: MOODLE_ID:klasor_adi seklinde, virgul ile ayir
# Moodle ders ID'sini bulmak icin: dersin Moodle sayfasindaki URL'de course/view.php?id=XXXXX
COURSES=85966:ie201_programming,85764:ie341_economics,84679:ie423_quality
